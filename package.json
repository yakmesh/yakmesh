    "./oracle/ma902-snmp": "./oracle/ma902-snmp.js",
    "./oracle/phase-epoch": "./oracle/phase-epoch.js",
    "./oracle/consensus": "./oracle/consensus-engine.js",
    "./oracle/validation": "./oracle/validation-oracle-hardened.js",
    "./oracle/genesis": "./oracle/genesis-network-v2.js",
    "./oracle/identity": "./oracle/network-identity.js",
    "./oracle/code-proof": "./oracle/code-proof-protocol.js",
    "./oracle/module-sealer": "./oracle/module-sealer.js",
    "./oracle/codebase-lock": "./oracle/codebase-lock.js",
    "./security/crypto-config": "./security/crypto-config.js",
    "./security/namche-gateway": "./security/namche-gateway.js",
    "./security/doko-identity": "./security/doko-identity.js",
    "./security/tls-binding": "./security/tls-binding.js",
    "./security/hybrid-trust": "./security/hybrid-trust.js",
    "./security/domain-consensus": "./security/domain-consensus.js",
    "./security/khata-protocol": "./security/khata-protocol.js",
    "./security/mesh-auth": "./security/mesh-auth.js",
    "./security/mesh-revocation": "./security/mesh-revocation.js",
    "./security/hardware-attestation": "./security/hardware-attestation.js",
    "./security/trust-tier": "./security/trust-tier.js",
    "./security/sakshi": "./security/sakshi.js",
    "./security/silicon-parity": "./security/silicon-parity.js",
    "./security/sybil-graph": "./security/sybil-graph.js",
    "./security/khata-trust-integration": "./security/khata-trust-integration.js",
    "./security/geo-proof": "./security/geo-proof.js",
    "./security/strike-system": "./security/strike-system.js",
    "./security/sangha": "./security/sangha.js",
    "./security/fs-hardening": "./security/fs-hardening.js",
    "./security/memory-safety": "./security/memory-safety.js",
    "./security/temporal-signing": "./security/temporal-signing.js",
    "./security/karma-rate-limiter": "./security/karma-rate-limiter.js",
    "./security/secure-config": "./security/secure-config.js",
    "./identity/node-key": "./identity/node-key.js",
    "./mesh/network": "./mesh/network.js",
    "./mesh/rate-limiter": "./mesh/rate-limiter.js",
    "./mesh/message-validator": "./mesh/message-validator.js",
    "./mesh/replay-defense": "./mesh/replay-defense.js",
    "./mesh/sybil-defense": "./mesh/sybil-defense.js",
    "./mesh/echo-ranging": "./mesh/echo-ranging.js",
    "./mesh/pulse-sync": "./mesh/pulse-sync.js",
    "./mesh/nakpak-routing": "./mesh/nakpak-routing.js",
    "./mesh/beacon-broadcast": "./mesh/beacon-broadcast.js",
    "./mesh/sherpa-discovery": "./mesh/sherpa-discovery.js",
    "./mesh/annex": "./mesh/annex.js",
    "./mesh/temporal-encoder": "./mesh/temporal-encoder.js",
    "./utils/accel": "./utils/accel.js",
    "./protocol/yak-protocol": "./protocol/yak-protocol.js",
    "./adapters/byond": "./adapters/adapter-byond/index.js",
    "./adapters/byond/topic-client": "./adapters/adapter-byond/topic-client.js",
    "./adapters/byond/http-bridge": "./adapters/adapter-byond/http-bridge.js",
    "./adapters/byond/security": "./adapters/adapter-byond/security.js",
    "./embedded-docs": "./embedded-docs/index.js",
    "./embedded-docs/verify": "./embedded-docs/verify.js",
    "./embedded-docs/serve": "./embedded-docs/serve.js",
    "./embedded-docs/bundle": "./embedded-docs/bundle.js"
  },
  "bin": {
    "yakmesh": "cli/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:docs": "node scripts/build-docs-bundle.mjs",
    "build:public": "node scripts/build-public.mjs",
    "prebuild": "npm run build:docs && npm run build:public",
    "test": "node --test oracle/tests/*.test.js",
    "test:time": "node --test oracle/tests/time-source.test.js",
    "test:phase": "node --test oracle/tests/phase-epoch.test.js",
    "test:crypto": "node --test oracle/tests/crypto.test.js",
    "test:oracle": "node --test oracle/tests/*.test.js",
    "test:protocol": "node --test protocol/tests/*.test.js",
    "test:multinode": "node --test tests/multi-node.test.js",
    "test:security": "npx vitest run",
    "test:byond": "node --test adapters/adapter-byond/tests/*.test.js",
    "test:all": "npm run test:oracle && npm run test:protocol && npm run test:multinode && npm run test:byond && npm run test:security",
    "audit": "node scripts/security-audit.mjs",
    "audit:fix": "node scripts/security-audit.mjs --fix",
    "audit:sbom": "node scripts/security-audit.mjs --sbom",
    "audit:ci": "node scripts/security-audit.mjs --json",
    "prerelease": "npm run audit && npm run test:all"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@noble/post-quantum": "^0.5.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "node-forge": "^1.3.3",
    "onnxruntime-node": "^1.24.2",
    "sql.js": "^1.10.0",
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "net-snmp": "^3.26.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "p2p",
    "mesh",
    "decentralized",
    "yakmesh",
    "yak",
    "post-quantum",
    "distributed-oracle",
    "onion-routing",
