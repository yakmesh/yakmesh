# YakBot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
# Go to: https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# Discord Application/Client ID (from Discord Developer Portal)
# Go to: https://discord.com/developers/applications → Your App → General Information → Application ID
DISCORD_CLIENT_ID=your_application_id_here

# Discord Webhook URL (for automated announcements)
# Go to: Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Optional: Guild ID for instant command testing
# Right-click server icon → Copy ID (enable Developer Mode in Discord settings)
# DISCORD_GUILD_ID=your_server_id
