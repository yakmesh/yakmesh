# YAKMESH Caddyfile - Unified Development + Production
# 
# Usage:
#   Development: caddy run --config deploy/Caddyfile
#   Production:  Set YAKMESH_DOMAIN env var, then caddy run
#
# Access:
#   Local HTTPS: https://localhost:8443
#   Production:  https://your-domain.com (when YAKMESH_DOMAIN is set)
#
# ═══════════════════════════════════════════════════════════════════════════════

# Global options
{
    email admin@yakmesh.dev
    
    # Enable HTTP/3
    servers {
        protocols h1 h2 h2c h3
    }
}

# ═══════════════════════════════════════════════════════════════════════════════
# LOCALHOST DEVELOPMENT (always active)
# Self-signed cert for local HTTPS - access via https://localhost:8443
# ═══════════════════════════════════════════════════════════════════════════════

localhost:8443 {
    tls internal
    
    # SHERPA Beacon
    handle /.well-known/yakmesh/* {
        reverse_proxy localhost:3000
    }
    
    # WebSocket (mesh network)
    handle /ws {
        reverse_proxy localhost:9001
    }
    
    # All other requests
    handle {
        reverse_proxy localhost:3000
    }
    
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }
    
    encode gzip zstd
}

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION TEMPLATE
# Copy this block and replace yakmesh.dev with your domain
# Caddy will auto-provision Let's Encrypt certificates
# ═══════════════════════════════════════════════════════════════════════════════

