{
  "apps": [{
    "name": "yakmesh",
    "script": "server/index.js",
    "cwd": "./",
    "watch": false,
    "autorestart": true,
    "max_restarts": 10,
    "restart_delay": 5000,
    "env": { "NODE_ENV": "production" },
    "error_file": "./logs/yakmesh-error.log",
    "out_file": "./logs/yakmesh-out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
  }]
}
