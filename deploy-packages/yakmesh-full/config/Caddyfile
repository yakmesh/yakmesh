# YAKMESH Self-Contained - Caddyfile
# Full package with PHP enabled

{
    admin off
    auto_https off
}

:8080 {
    root * ./htdocs
    
    # Enable file server with directory browsing
    file_server browse
    
    # PHP FastCGI handling
    @phpFiles {
        path *.php
    }
    handle @phpFiles {
        root * ./htdocs
        php_fastcgi localhost:9000 {
            # Use bundled PHP-CGI
            split .php
        }
    }
    
    # Reverse proxy to Content API
    handle /content/* {
        reverse_proxy localhost:3000
    }
    
    # API proxy
    handle /api/* {
        reverse_proxy localhost:3000
    }
    
    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    
    # Enable compression
    encode gzip zstd
    
    # Logging
    log {
        output file ./logs/caddy-access.log
        format json
        level INFO
    }
}

# HTTPS site (uncomment for production)
# :8443 {
#     tls internal
#     import :8080
# }
