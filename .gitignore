# but C2C game art and YakAI portraits are build-time copies.
public/c2c/
public/yakai/

# Temporary test/debug files
test-verify-*.mjs
test-full-hash.mjs
test-hash-analysis.mjs
php-timing-test.php

# Config files with sensitive data
test-nodes/data-*/
memory-bank/
yakmesh.config.js
